# Non-production examples only. Replace every value and path before deployment.
POSTGRES_DB=litellm
POSTGRES_USER=llmproxy
POSTGRES_PASSWORD=replace-with-a-random-postgres-password
LITELLM_MASTER_KEY=sk-replace-with-a-long-expiring-admin-key
LITELLM_SALT_KEY=replace-with-a-long-random-salt-key
TRANSLATOR_SERVICE_KEY=replace-with-a-random-compose-service-key
OPENAI_CREDENTIALS_HOST_DIR=/absolute/path/outside/repository/luna-credentials
TRANSLATOR_UID=1000
TRANSLATOR_GID=1000
OPENAI_REFRESH_TOKEN_WRITE_FILE=/run/credentials/refresh-token
LITELLM_HOST_PORT=4000
CLOUDFLARE_TUNNEL_TOKEN=replace-only-if-edge-is-enabled

# Public OmniLion NVFP4 W4A16 snapshot. No Hugging Face token is required.
OMNILION_MODEL=LLJYY/OmniLion-NVFP4-W4A16
OMNILION_REVISION=cc2628352cf7eb76c93b992c4f3079f4b3bc9498
OMNILION_MANIFEST_SHA256=b69cec09f3e6dfbf713485eb637c2909ed43704791f4ecb208b0b69bb0e7d8e0
OMNILION_VENV=/absolute/path/to/omnilion-vllm-0.29.0
OMNILION_API_KEY=replace-with-a-random-internal-service-key
OMNILION_API_BASE=http://host.docker.internal:8002/v1
OMNILION_BIND_HOST=172.17.0.1
OMNILION_PORT=8002
OMNILION_MAX_MODEL_LEN=8192
OMNILION_GPU_MEMORY_UTILIZATION=0.65
OMNILION_VIDEO_NUM_FRAMES=30
OMNILION_STARTUP_TIMEOUT=900
OMNILION_BACKEND_TIMEOUT_MS=300000
HF_HOME=/absolute/path/outside/repository/huggingface
HF_HUB_DISABLE_IMPLICIT_TOKEN=1

# Optional dormant Compose profile build pins.
OMNILION_VLLM_BASE_IMAGE=nvcr.io/nvidia/vllm:26.05.post1-py3
OMNILION_VLLM_IMAGE=dell-innovatefest-2026-serving-omnilion-vllm:0.1.0
OMNILION_PLUGIN_SHA256=989711f66d16fb7f1e6e943c7b73babf0ab53018abf45276889ab89bd2a1df07
